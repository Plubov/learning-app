# Copy this file to .env and fill in the values.
# Find them in the Supabase dashboard: Project Settings -> API Keys / Data API.
# EXPO_PUBLIC_ variables are bundled into the app, so only public values go here:
# the publishable key is safe in the client because Row Level Security protects the data.
# Never put the secret key or any AI provider key in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
